# AI-Based Placement Preparation Portal - Environment Variables Template
# Copy this file to .env for local development or set these variables in Render / Cloud Dashboard

# 1. Flask Configuration
SECRET_KEY=placement_portal_secret_key_98765
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# 1.1 Custom Domain & Production Host Settings
CUSTOM_DOMAIN=www.placementpreparationportal.com
ALLOWED_HOSTS=www.placementpreparationportal.com,placementpreparationportal.com,127.0.0.1,localhost
APP_URL=https://www.placementpreparationportal.com
CORS_ORIGINS=https://www.placementpreparationportal.com,http://www.placementpreparationportal.com,https://placementpreparationportal.com,http://placementpreparationportal.com,http://127.0.0.1:5000,http://localhost:5000

# 1.1 Initial Administrator Default Credentials (Idempotently created on first run only)
# IMPORTANT: Change these values in production before first boot!
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=ChangeThisAdminPassword!123
ADMIN_DEFAULT_EMAIL=admin@prepportal.com

# 2. Database Connection Options
# -------------------------------------------------------------
# Choose DB_TYPE: 'mysql', 'postgres', or 'sqlite'
DB_TYPE=mysql

# Option A: MySQL Server Configuration (Local MySQL, XAMPP, WAMP, Docker, RDS, Railway)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=placement_portal

# Option B: Database URL (PostgreSQL or MySQL Connection String)
# PostgreSQL: postgresql://user:password@host:5432/dbname
# MySQL:      mysql+pymysql://root:password@127.0.0.1:3306/placement_portal
DATABASE_URL=

# Option C: SQLite (Fallback local file database)
SQLITE_DB_PATH=backend/database/portal.db

# 3. AI Service API Keys (Optional - Falls back to Mock Mode if empty)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 4. Email Notification Settings (Gmail SMTP & Standard SMTP)
# -------------------------------------------------------------
# For Gmail Delivery:
# 1. Enable 2-Step Verification on your Google Account (https://myaccount.google.com/security)
# 2. Generate a 16-character Google App Password (https://myaccount.google.com/apppasswords)
# 3. Enter your Gmail address as MAIL_USERNAME and the 16-char App Password as MAIL_PASSWORD
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
MAIL_DEFAULT_SENDER=your_email@gmail.com
ADMIN_NOTIFICATION_EMAIL=admin@prepportal.com

# 5. Automated Email Target Exclusions (Test / Personal accounts excluded from bulk portal notifications)
EMAIL_NOTIFICATION_EXCLUDED_USERS=

# Backward-compatible fallback aliases
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
MAIL_FROM=your_email@gmail.com

# 6. Firebase Integration Configuration
# -------------------------------------------------------------
# Option A: Production Environment Variables (Recommended for Render, Vercel, Railway, Cloud)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Format for private key: standard PEM string with newlines or "\n"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# Option B: Local Development Service Account JSON file path (e.g. backend/config/serviceAccountKey.json)
# DO NOT COMMIT THIS FILE TO GIT! It is listed in .gitignore.
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=

# Client-Safe Web SDK Configuration (Optional - for browser auth or FCM push tokens)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
FIREBASE_WEB_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
FIREBASE_WEB_APP_ID=1:1234567890:web:abcdef123456
FIREBASE_WEB_MESSAGING_SENDER_ID=1234567890
